{
  "cli": {
    "version": ">= 16.13.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APPWRITE_ENDPOINT": "https://cloud.appwrite.io/v1",
        "EXPO_PUBLIC_APPWRITE_PROJECT_ID": "your-project-id",
        "EXPO_PUBLIC_APPWRITE_PLATFORM": "com.flipzy.app",
        "EXPO_PUBLIC_DB_ID": "your-db-id",
        "EXPO_PUBLIC_HABITS_COLLECTION_ID": "your-collection-id"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APPWRITE_ENDPOINT": "https://cloud.appwrite.io/v1",
        "EXPO_PUBLIC_APPWRITE_PROJECT_ID": "your-project-id",
        "EXPO_PUBLIC_APPWRITE_PLATFORM": "com.flipzy.app",
        "EXPO_PUBLIC_DB_ID": "your-db-id",
        "EXPO_PUBLIC_HABITS_COLLECTION_ID": "your-collection-id"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APPWRITE_ENDPOINT": "https://cloud.appwrite.io/v1",
        "EXPO_PUBLIC_APPWRITE_PROJECT_ID": "your-project-id",
        "EXPO_PUBLIC_APPWRITE_PLATFORM": "com.flipzy.app",
        "EXPO_PUBLIC_DB_ID": "your-db-id",
        "EXPO_PUBLIC_HABITS_COLLECTION_ID": "your-collection-id"
      }
    },
    "production-store": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APPWRITE_ENDPOINT": "https://cloud.appwrite.io/v1",
        "EXPO_PUBLIC_APPWRITE_PROJECT_ID": "your-project-id",
        "EXPO_PUBLIC_APPWRITE_PLATFORM": "com.flipzy.app",
        "EXPO_PUBLIC_DB_ID": "your-db-id",
        "EXPO_PUBLIC_HABITS_COLLECTION_ID": "your-collection-id"
      }
    }
  },
  "submit": {
    "production-store": {}
  }
}
